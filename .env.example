# Copy to .env.local for local development. Never commit real values.
# In production these are set in Webflow Cloud > Environment Variables,
# with "Secret" toggled on for the two keys.

# Anthropic Console API key (secret)
ANTHROPIC_API_KEY=

# Memberstack secret key (secret)
MEMBERSTACK_SECRET_KEY=

# Mount path. Leave empty locally (the app runs at the root).
# In Webflow Cloud set it to /app (not secret).
NEXT_PUBLIC_BASE_PATH=

# Comma-separated emails that get the admin page (not secret).
ADMIN_EMAILS=

# Memberstack public key. Optional: src/lib/config.ts falls back to the
# sandbox key. Set this to the live key at launch.
NEXT_PUBLIC_MEMBERSTACK_PUBLIC_KEY=
